          }
        }
      }
      collaborators {
        user {
          ...MultiplayerUser
        }
      }
      authorizations {
        editPermissions {
          isAuthorized
        }
      }
      multiplayerInvites {
        email
        type
      }
    }
  }
  currentUser {
    id
    username
    fullName
    image
    url
    isSubscribed
    customer {
      ...CollaboratorCountV2Customer
      ...InvitePromotionsCustomer
    }
  }
}

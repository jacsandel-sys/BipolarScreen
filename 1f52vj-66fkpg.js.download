    org(orgId: $orgId) {
      ... on Org {
        id
      }
    }
  }
}
    `,o=t.gql`
    query UpgradeWelcomeTopUpContext($customerId: Int!) {
  getCustomer(customerId: $customerId) {
    ... on Customer {
      id
      topUpState {
        __typename
        ... on CustomerTopUpState {
          autoTopUp {
            __typename
            ... on CustomerAutoTopUpPaymentFailed {
              invoice {
                id
                hostedInvoiceUrl
              }
            }
            ... on CustomerAutoTopUpDisabledMonthlyCap {
              disabledAt
            }
          }
        }
      }
      billing {
        ... on CustomerBilling {
          arrangement {
            ... on CustomerSelfServeSubscription {
              plan {
                ... on TieredSelfServePlan {
                  tier
                }
              }
            }
          }
        }
      }
    }

    id
    customer {
      __typename
      ... on Customer {
        id
        authorizations {
          enablePromotions {
            isAuthorized
          }
        }
      }
    }
    personalOrgAuthorizations {
      __typename
      ...ConversationAgentAuthorizations
    }
  }
  getOrg(orgId: $orgId) @include(if: $hasOrg) {
    __typename
    ... on Org {
      id
      customer {
        __typename
        ... on Customer {
          id
          authorizations {
            enablePromotions {
              isAuthorized
            }
          }
        }
      }
      authorizations {
        ...ConversationAgentAuthorizations
      }
    }
  }
}

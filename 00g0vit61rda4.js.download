    `,r=t.gql`
    query DatabaseSettingsNeonConfigurations($replId: String!) {
  repl(id: $replId) {
    ... on Repl {
      id
      authorizations {
        useDatabaseSnapshots {
          isAuthorized
          message
        }
        editDatabaseSettings {
          isAuthorized
          message
        }
        manageSnapshotSchedule {
          isAuthorized
          message
        }
        restoreSnapshot {
          isAuthorized
          message
        }
        rotateDatabaseCredentials {
          isAuthorized
          message
        }
      }
      neonDatabaseConfigurations {
        historyRetentionOptions {
          value
          title
        }
        snapshotRetentionOptions {
          value
          title
        }
      }
    }

    fragment AiScanVulnerabilitiesData on Repl {
  aiSecurityScan {
    __typename
    ... on AIScanVulnerabilities {
      vulnerabilityGroups {
        id
        scanTaskId
        title
        description
        vulnerabilities {
          id
          title
          description
          severity
          paths
          state
          updatedAt
        }
      }
    }
    ... on UnauthorizedError {
      message
    }
    ... on NotFoundError {
      message
    }
    ... on ServiceUnavailable {
      message
    }
  }
}
    `,n=t.gql`
    query ReplAiScanVulnerabilities($replId: String!) {
  currentUser {
    __typename
    ... on CurrentUser {
      id
      userSubscriptionType
      customer {
        ... on Customer {
          id
          authorizations {
            editSettings {
              isAuthorized
            }
          }
        }
      }
    }
  }
  getRepl(id: $replId) {
    __typename
    ... on Repl {
      id
      orgPublicInfo {
        __typename
        ... on OrgPublicInfo {
          id
          slug
        }
      }
      org {
        id
        customer {
          ... on Customer {
            id
            authorizations {
              editSettings {
                isAuthorized
              }
            }
          }
        }
      }
      isWorkspaceAdmin
      authorizations {
        viewAiSecurityScan {

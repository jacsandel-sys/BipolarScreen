    query ConfigureTabRepl($id: String!) {
  getRepl(id: $id) {
    ... on Repl {
      id
      title
      iconUrl
      timeCreated
      authorizations {
        editMetadata {
          isAuthorized
        }
        manageAuth {
          isAuthorized
        }
        manageClerkDashboard {
          isAuthorized
          code
        }
      }
      authProviderConfig {
        ... on AuthProviderConfig {
          id
          minimizedProviders
          hideMinimizedProviders
        }
      }
      config {
        sessionSecretRotatedAt
      }
      deploymentMetadata {
        ... on DeploymentMetadata {
          id
          url
        }
      }
    }

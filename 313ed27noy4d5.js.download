    ... on Team {
      id
      username
    }
  }
  org {
    __typename
    id
    slug
    type
  }
  hostingDeployment {
    ... on HostingDeployment {
      id
      replitBadgeEnabled
      agentInboxEnabled
      agentInboxConfig {
        position
        bgColor
        logoSrc
      }
      analyticsEnabled
      uptimeCheckEnabled
    }
  }
  config {
    replitBadgeEnabled
  }
  domains @include(if: $includeDomains) {
    ... on Domain {
      id
      hosting_deployment_id
      domain
      state
    }
  }
}
    `,n=t.gql`
    query DeploymentsNewDeployment($replId: String!, $includeDomains: Boolean = false) {

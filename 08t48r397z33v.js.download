strict";let t={"stripe-mcp":{longDescription:"Stripe is a leading payments infrastructure platform for businesses of all sizes. This integration gives you access to customers, charges, subscriptions, invoices, and payment intents. Use it to automate billing workflows, sync subscription state, or build custom payment dashboards.",longDescriptionIntlId:"connectors.stripeMcpLongDescription"},linear:{longDescription:"Linear is a fast, opinionated issue tracker built for high-velocity engineering teams. This integration lets you create and update issues, read project and team data, manage cycles and milestones, and listen for issue events. Use it to power engineering ops tools, cross-project dashboards, or development workflow automations.",longDescriptionIntlId:"connectors.linearMcpLongDescription"},notion:{longDescription:"Notion is an all-in-one workspace for notes, wikis, and project management. This integration lets you create and update pages and databases, query database entries with filters, and read block content. Use it to sync external data into Notion or surface Notion content inside your app.",longDescriptionIntlId:"connectors.notionMcpLongDescription"},sentry:{longDescription:"Sentry is an application monitoring platform focused on error tracking, performance, and release health. This integration lets you read issues and events, manage projects and teams, resolve or assign errors, and query performance data. Use it to build custom error triage tools, sync issues to other trackers, or automate alert routing.",longDescriptionIntlId:"connectors.sentryMcpLongDescription"},atlassian:{longDescription:"Atlassian's suite—Jira, Confluence, and related tools—is the backbone of software development and knowledge management for thousands of teams. Create issues, update sprints, search Confluence spaces, and move work through workflows without switching to a browser. Engineering and product teams accelerate delivery by connecting Atlassian data to their automation and reporting pipelines.",longDescriptionIntlId:"connectors.atlassianMcpLongDescription"},miro:{longDescription:"Miro is a collaborative online whiteboard platform used for brainstorming, diagramming, and design sprints. This integration lets you create boards, add and update cards and sticky notes, and read board content. Use it to automate workshop setup, sync project data onto boards, or extract whiteboard content into structured records.",longDescriptionIntlId:"connectors.miroMcpLongDescription"},posthog:{longDescription:"PostHog is an open-source product analytics platform supporting events, funnels, session recordings, and feature flags. This integration lets you capture and query events, manage feature flags and experiments, and access person and cohort data. Use it to surface PostHog insights in external dashboards, toggle features programmatically, or build data export pipelines.",longDescriptionIntlId:"connectors.posthogMcpLongDescription"},amplitude:{longDescription:"Amplitude is a product analytics platform for understanding how users interact with your app. This integration lets you query events, charts, and cohorts, and access user and session data. Use it to surface Amplitude insights in internal dashboards, trigger workflows based on behavioral segments, or export event data for further analysis.",longDescriptionIntlId:"connectors.amplitudeMcpLongDescription"},granola:{longDescription:"Granola is an AI notepad that runs locally on your Mac, capturing and structuring meeting notes without requiring a bot in the call. Integrating Granola lets you automatically push meeting summaries, decisions, and action items to project management or CRM tools after each call. This eliminates post-meeting note transcription and keeps follow-up tasks from slipping.",longDescriptionIntlId:"connectors.granolaMcpLongDescription"},twilio:{longDescription:"Integrate Twilio to send and receive SMS messages, initiate voice calls, and handle inbound communication events programmatically. Build two-way messaging workflows, automated phone trees, and real-time alerts that reach users on any device. Add reliable, scalable communication capabilities to any application or automation pipeline.",longDescriptionIntlId:"connectors.twilioMcpLongDescription"},mercury:{longDescription:"Mercury is a business banking platform built for startups and technology companies, offering FDIC-insured accounts, cards, and treasury tools. Integrating Mercury lets you sync transaction data with accounting tools, automate payment reconciliation, and trigger alerts based on account activity. This keeps financial records accurate and reduces manual bookkeeping for finance teams.",longDescriptionIntlId:"connectors.mercuryMcpLongDescription"},zapier:{longDescription:"Integrate Zapier to invoke zaps programmatically, pass webhook payloads, and coordinate automation across the thousands of apps in Zapier's ecosystem. Use Zapier as a bridge when a native integration isn't available and chain its automations with other workflow tools. Extend your automation reach without building custom connectors for every target system.",longDescriptionIntlId:"connectors.zapierMcpLongDescription"},"apollo-oauth":{longDescription:"Apollo.io is a sales intelligence and engagement platform with a large B2B contact database. This integration lets you search and enrich contact and company data, manage sequences, and read engagement activity. Use it to build prospecting tools, enrich sign-up data with firmographic information, or automate outreach workflows.",longDescriptionIntlId:"connectors.apolloMcpLongDescription"}},n={...t,apollo:t["apollo-oauth"],stripe:t["stripe-mcp"]};e.s(["PREDEFINED_MCP_PROVIDER_LONG_DESCRIPTIONS",0,n])}]);


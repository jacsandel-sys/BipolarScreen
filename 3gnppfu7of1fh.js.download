      ...ScheduledDowngradeBanner_scheduledDowngrade
    }
    billingInfo {
      planInfo {
        interval
        externalId
      }
    }
    customer {
      id
      proTierDowngradesEnabled: isGateEnabled(gate: "gate_pro_tier_downgrades_server") @include(if: $isDowngradeEnabled)
      authorizations {
        downgradeSubscription {
          isAuthorized
        }
      }
      billing {
        __typename
        ... on CustomerBilling {
          arrangement {
            __typename
            ... on CustomerSelfServeSubscription {
              subscriptionEndDate
            }
          }
        }
      }
    }
  }
}

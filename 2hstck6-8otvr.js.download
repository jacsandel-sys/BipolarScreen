    `,n=t.gql`
    query AgentSkillsLibraryForRepl($replId: String!, $includePersonalLibrary: Boolean!, $adminGroupsInput: OrgGroupsInput!) {
  currentUser {
    id
    username
    fullName
    personalOrgAuthorizations @include(if: $includePersonalLibrary) {
      __typename
      ... on OrgAuthorizations {
        createOrgCustomSkills {
          isAuthorized
        }
      }
    }
    customSkillLibrary @include(if: $includePersonalLibrary) {
      __typename
      ... on UserCustomSkillLibraryResult {
        entries {
          ...AgentSkillsLibraryEntry
        }
      }
      ... on UnauthorizedError {
        message
      }
    }
  }
  getRepl(id: $replId) {
    __typename
    ... on Repl {
      id
      canPromoteProjectSkillToWorkspace
      org {
        id
        name
        slug
        workspaceMemberCount: membersCount
        adminGroups: groups(input: $adminGroupsInput) {
          __typename
          ... on OrgGroupConnection {
            items {
              id
              memberCount
              isMember
            }
          }
        }
        authorizations {
          viewOrgCustomSkills {
            isAuthorized
          }
          createOrgCustomSkills {
            isAuthorized
          }
          forceEnableCustomSkills {
            isAuthorized
          }
          manageGithubSkills {
            isAuthorized
          }
        }
        customSkillLibrary {
          __typename
          ... on OrgCustomSkillLibraryResult {
            entries {
              ...AgentSkillsLibraryEntry
            }
          }
          ... on UnauthorizedError {
            message
          }
        }
      }
    }
    ... on NotFoundError {
      message
    }
    ... on UnauthorizedError {
      message
    }
  }
}
    ${l}`,o=t.gql`
    mutation AgentSkillsSetUserCustomSkillEnabled($input: SetUserCustomSkillEnabledInput!) {
  setUserCustomSkillEnabled(input: $input) {
    __typename
    ... on SetUserCustomSkillEnabledResult {
      enabled
      customSkill {
        id
      }
    }
    ... on NotFoundError {
      message
    }
    ... on UnauthorizedError {
      message
    }
    ... on UserError {
      message
    }
  }
}
    `,d=t.gql`

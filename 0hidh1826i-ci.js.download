    `,r=t.gql`
    fragment OrgReplOwnerOrg on Org {
  id
  name
  slug
  image
  dealContext {
    dealType
    salesContactEmail
  }
  authorizations {
    ...CreateReplAuthorizations
    ... on OrgAuthorizations {
      editPaymentMethod {
        isAuthorized
      }
    }
  }
  groups(input: {types: [system_viewers]}) {
    ... on OrgGroupConnection {
      items {
        id
        type
        isMember
      }
    }
  }
}

    query PublishHistoryActivityLogs($replId: String!, $count: Int!) {
  getRepl(id: $replId) {
    ... on Repl {
      id
      hostingDeployment {
        ... on HostingDeployment {
          id
          activityLogs(count: $count) {
            items {
              id
              type
              timeCreated
              build {
                id
                status
                provider
                hasDeployLogs
                timeCreated
                user {
                  id
                  displayName
                  username
                  fullName
                  image
                }
              }
            }
            pageInfo {
              hasNextPage
              nextCursor
            }
          }
        }
      }
    }
  }
}
